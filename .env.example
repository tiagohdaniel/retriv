ANTHROPIC_API_KEY=sk-ant-your-key-here

# API authentication — disabled by default for local dev
# Set to true in production and provide a strong random key
API_AUTH_ENABLED=false
API_KEY=
# Multi-tenant: comma-separated "key:tenant_id" pairs
# When set, API_KEY (single-tenant) is ignored
# API_KEYS=key1:tenant1,key2:tenant2

# LLM
LLM_BACKEND=anthropic   # anthropic | (future: openai, ollama, ...)
MODEL_NAME=claude-sonnet-4-6
LLM_TIMEOUT=30.0

# Embeddings
# ⚠️  Changing this after indexing requires reindexing all sources (incompatible vector spaces)
EMBEDDING_MODEL=nomic-ai/nomic-embed-text-v1.5

# Vector store
# Local dev:   CHROMA_MODE=embedded (default)
# Production:  CHROMA_MODE=server — ChromaDB runs as a separate container (docker-compose)
# Cloud:       CHROMA_MODE=cloud  — Chroma Cloud (managed, persistent)
CHROMA_MODE=embedded
CHROMA_PERSIST_DIR=./chroma_data
CHROMA_HOST=localhost
CHROMA_PORT=8000
# CHROMA_CLOUD_API_KEY=    # required when CHROMA_MODE=cloud
# CHROMA_CLOUD_TENANT=     # required when CHROMA_MODE=cloud
# CHROMA_CLOUD_DATABASE=   # required when CHROMA_MODE=cloud

# Chunking
# CHUNK_SIZE: target characters per chunk. 400 works well for dense legal/fiscal text;
# increase to 600-800 for documents with long paragraphs.
# CHUNK_OVERLAP: budget for overlap (Strategy C). The last complete sentence is always
# carried even if it exceeds this budget. Budget controls additional sentences prepended
# working backwards from the end of the chunk.
CHUNKING_STRATEGY=semantic   # "semantic" (paragraph/sentence-aware) | "fixed" (char sliding window)
CHUNK_SIZE=800
CHUNK_OVERLAP=100

# Hybrid search: BM25 + semantic → RRF merge (disabled by default)
# Enable for queries that mix exact terms (codes, acronyms) with semantic queries.
HYBRID_ENABLED=false
HYBRID_BM25_CORPUS_LIMIT=200   # max chunks loaded into BM25 corpus (≤ 200 for Chroma Cloud)

# Reranker: cross-encoder second pass (disabled by default — requires model download on first use)
# RERANKER_MODEL options:
#   BAAI/bge-reranker-base         — multilingual, ~280MB ONNX (recommended)
#   Xenova/ms-marco-MiniLM-L-6-v2  — English-only, ~22MB (lighter)
RERANKER_ENABLED=false
RERANKER_MODEL=BAAI/bge-reranker-base
RERANKER_TOP_K_FETCH=30   # candidates retrieved before reranking (increase for denser corpora)
RERANKER_TOP_N=5          # candidates kept after reranking (sent to LLM)

# Source diversity: cap chunks per source in retrieval pool (disabled by default)
# Enable when a single large document (many chunks) tends to dominate top-k results,
# crowding out potentially relevant content from smaller sources.
SOURCE_DIVERSITY_ENABLED=false
SOURCE_DIVERSITY_MAX_PER_SOURCE=3

# Rate limiting — disabled by default for local dev
# Enable in production to protect against API key abuse and LLM cost overruns
RATE_LIMIT_ENABLED=false
RATE_LIMIT_INDEX=10/minute
RATE_LIMIT_ASK=30/minute
RATE_LIMIT_SOURCES=60/minute
RATE_LIMIT_ANALYZE=20/minute

# Analytics pipeline
ANALYTICS_MAX_ROWS=100000
ANALYTICS_MAX_FILE_SIZE_MB=10

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json       # "json" for production / log aggregators, "console" for local dev

# HTTP
CORS_ORIGINS=*        # comma-separated list of allowed origins, or "*" to allow all
WEB_CONCURRENCY=2     # number of Gunicorn worker processes

# Observability
METRICS_ENABLED=true
# METRICS_USERNAME=   # Basic auth for /metrics — leave empty to disable auth
# METRICS_PASSWORD=

# RAG evaluation via Langfuse (disabled by default)
# Create a free account at https://langfuse.com and copy your project keys.
# Every /ask query is evaluated asynchronously (zero added latency) and scored for:
#   - faithfulness: is the answer supported by the retrieved context?
#   - answer_relevancy: does it actually address the question?
EVAL_ENABLED=false
EVAL_MODEL=claude-haiku-4-5-20251001  # lightweight model used as LLM judge — cheaper than the main model
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com  # or your self-hosted URL
