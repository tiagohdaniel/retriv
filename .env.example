ANTHROPIC_API_KEY=sk-ant-your-key-here

# API authentication — disabled by default for local dev
# Set to true in production and provide a strong random key
API_AUTH_ENABLED=false
API_KEY=

# LLM
MODEL_NAME=claude-sonnet-4-20250514
LLM_TIMEOUT=30.0

# Embeddings
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Vector store
# Local dev:   CHROMA_MODE=embedded (default)
# Production:  CHROMA_MODE=server — ChromaDB runs as a separate container
CHROMA_MODE=embedded
CHROMA_PERSIST_DIR=./chroma_data
CHROMA_HOST=localhost
CHROMA_PORT=8000

# Chunking
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# Rate limiting — disabled by default for local dev
# Enable in production to protect against API key abuse and LLM cost overruns
RATE_LIMIT_ENABLED=false
RATE_LIMIT_INDEX=10/minute
RATE_LIMIT_ASK=30/minute
RATE_LIMIT_SOURCES=60/minute

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json       # "json" for production / log aggregators, "console" for local dev

# HTTP
CORS_ORIGINS=*        # comma-separated list of allowed origins, or "*" to allow all
WEB_CONCURRENCY=2     # number of Gunicorn worker processes

# Observability
METRICS_ENABLED=true  # exposes GET /metrics in Prometheus text format
