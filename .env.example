ANTHROPIC_API_KEY=sk-ant-your-key-here

# API authentication — disabled by default for local dev
# Set to true in production and provide a strong random key
API_AUTH_ENABLED=false
API_KEY=

# LLM
LLM_BACKEND=anthropic   # anthropic | (future: openai, ollama, ...)
MODEL_NAME=claude-sonnet-4-20250514
LLM_TIMEOUT=30.0

# Embeddings
# ⚠️  Changing this after indexing requires reindexing all sources (incompatible vector spaces)
EMBEDDING_MODEL=nomic-ai/nomic-embed-text-v1.5

# Vector store
# Local dev:   CHROMA_MODE=embedded (default)
# Production:  CHROMA_MODE=server — ChromaDB runs as a separate container
# Cloud:       CHROMA_MODE=cloud — Chroma Cloud (managed, persistent)
CHROMA_MODE=embedded
CHROMA_PERSIST_DIR=./chroma_data
CHROMA_HOST=localhost
CHROMA_PORT=8000
# CHROMA_CLOUD_API_KEY=    # required when CHROMA_MODE=cloud
# CHROMA_CLOUD_TENANT=     # required when CHROMA_MODE=cloud
# CHROMA_CLOUD_DATABASE=   # required when CHROMA_MODE=cloud

# Chunking
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# Rate limiting — disabled by default for local dev
# Enable in production to protect against API key abuse and LLM cost overruns
RATE_LIMIT_ENABLED=false
RATE_LIMIT_INDEX=10/minute
RATE_LIMIT_ASK=30/minute
RATE_LIMIT_SOURCES=60/minute

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json       # "json" for production / log aggregators, "console" for local dev

# HTTP
CORS_ORIGINS=*        # comma-separated list of allowed origins, or "*" to allow all
WEB_CONCURRENCY=2     # number of Gunicorn worker processes

# Observability
METRICS_ENABLED=true  # exposes GET /metrics in Prometheus text format
# PROMETHEUS_MULTIPROC_DIR=/tmp/prometheus_multiproc  # required for Gunicorn multi-worker metrics aggregation
# METRICS_USERNAME=                  # Basic auth for /metrics — leave empty to disable auth
# METRICS_PASSWORD=

# RAG evaluation via Langfuse (disabled by default)
# Create a free account at https://langfuse.com and copy your project keys
EVAL_ENABLED=false
EVAL_MODEL=claude-haiku-4-5-20251001  # lightweight model used as LLM judge — cheaper than the main model
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com  # or your self-hosted URL
